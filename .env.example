# Copie para .env e substitua os valores antes de iniciar.
DB_NAME=vendafacil
DB_USER=vendafacil
DB_PASSWORD=troque-por-uma-senha-local-forte
DB_PORT=5432
APP_PORT=8080
APP_BASE_DOMAIN=localhost
SPRING_PROFILES_ACTIVE=local
# Usada exclusivamente para as contas fictícias do profile local.
DEMO_PASSWORD=VendaFacil-Local-2026!
# E-mails de teste ficam na caixa local http://localhost:8025 (Mailpit).
MAILPIT_HTTP_PORT=8025
MAIL_FROM=acesso@vendafacil.example
# O Compose usa mailpit:1025 por padrão; Java fora do Docker usa localhost:1025.
# Para SMTP real, configure MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD,
# MAIL_SMTP_AUTH=true e MAIL_STARTTLS=true conforme o provedor.
