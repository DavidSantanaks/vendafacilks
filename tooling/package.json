{
  "name": "vendafacil-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Formatação e assets locais; nenhum servidor Node em produção",
  "scripts": {
    "vendor": "node sync-vendor.mjs",
    "lint": "cd .. && node tooling/node_modules/eslint/bin/eslint.js src/main/resources/static/js",
    "format": "cd .. && node tooling/node_modules/prettier/bin/prettier.cjs --write \"src/main/resources/templates/**/*.html\" \"src/main/resources/static/css/**/*.css\" \"src/main/resources/static/js/**/*.js\" \"tooling/*.mjs\" \"*.json\" \"*.mjs\"",
    "format:check": "cd .. && node tooling/node_modules/prettier/bin/prettier.cjs --check \"src/main/resources/templates/**/*.html\" \"src/main/resources/static/css/**/*.css\" \"src/main/resources/static/js/**/*.js\" \"tooling/*.mjs\" \"*.json\" \"*.mjs\""
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2"
  }
}
